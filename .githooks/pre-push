#!/bin/sh
# EnvThaw 仓库安全钩子：推送前检查本次要发布的提交里是否含私有/敏感路径。
# 需要临时放行时：ENVTHAW_ALLOW_SENSITIVE=1 git push ...
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
. "$ROOT/.githooks/lib-deny.sh"

zero=0000000000000000000000000000000000000000
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # 新分支：检查该提交可达的全部文件
    files=$(git log --pretty=format: --name-only "$local_sha" 2>/dev/null | sed '/^$/d' | sort -u)
  else
    files=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
  fi

  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if envthaw_is_sensitive "$f"; then
      if [ "${ENVTHAW_ALLOW_SENSITIVE:-0}" = "1" ]; then
        echo "⚠️  ENVTHAW_ALLOW_SENSITIVE=1，放行 $f" >&2
      else
        echo "   - $f" >&2
        blocked=1
      fi
    fi
  done <<EOF
$files
EOF
done

if [ "$blocked" = "1" ]; then
  echo "" >&2
  echo "✋ 推送被阻止：本次要发布的提交包含私有/敏感路径（见上）。" >&2
  echo "  请先从历史中移除，或确认目标是私有仓库后再放行：" >&2
  echo "    ENVTHAW_ALLOW_SENSITIVE=1 git push ..." >&2
  echo "" >&2
  exit 1
fi
exit 0
